# LINE LIFF Configuration (Production)
# Same-origin API in production so requests go through Nginx reverse proxy (/api -> localhost:5000)
VITE_LIFF_ID=2010927966-x2dyK16K
VITE_API_URL=/api
# บังคับ liff.logout() ทุกครั้งที่เปิดหน้าเว็บ (ใช้ตอนขอสิทธิ์ชุดใหม่ แล้วเปลี่ยนเป็น false เพื่อปิด)
VITE_FORCE_LOGOUT=true
